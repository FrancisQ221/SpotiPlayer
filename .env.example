# ==============================================================================
# SpotiPlayer - Multiplatform Environment Configuration (.env.example)
# Targets: Web, Windows Desktop (Tauri v2), Android (Capacitor)
# ==============================================================================

# Remote backend base URL consumed by SpotiPlayer services across all platforms
# Choose the URL that matches your runtime target:
#
# 1. Web & Local Development:
#    VITE_API_BASE_URL="http://localhost:3000"
#
# 2. Windows Desktop (Tauri v2):
#    VITE_API_BASE_URL="http://localhost:3000"
#    # Or remote backend:
#    # VITE_API_BASE_URL="https://api.spotiplayer.com"
#
# 3. Android Emulator (Capacitor):
#    # 10.0.2.2 is the default Android emulator route to the host machine's localhost
#    VITE_API_BASE_URL="http://10.0.2.2:3000"
#
# 4. Physical Android Device (Capacitor over local Wi-Fi):
#    # Replace with your workstation's local LAN IP (e.g. 192.168.1.120)
#    # VITE_API_BASE_URL="http://192.168.1.120:3000"
#
# 5. Production (Web, Desktop, Android APK):
#    VITE_API_BASE_URL="https://api.spotiplayer.com"
VITE_API_BASE_URL="https://api.spotiplayer.com"

# Network & Resilience Settings for Mobile & Flaky Connections
VITE_API_TIMEOUT_MS=12000
VITE_API_MAX_RETRIES=3

# Supabase Authentication & Multiplatform Session Persistence
# Configura la URL de tu proyecto y la Publishable Key de Supabase:
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_5kRIwybcslRjB_PyBBAxVA_WhN6RdCk"

# AI Studio runtime variables (auto-injected at runtime in AI Studio environment)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

